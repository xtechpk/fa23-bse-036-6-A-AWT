    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Brown\",\n  \"registrationNumber\": \"REG-1001\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"StrongPass123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res?.data?.id) {",
                  "  pm.collectionVariables.set('userId', res.data.id);",
                  "}",
                  "if (res?.data?.id) {",
                  "  pm.collectionVariables.set('targetUserId', res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "POST Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"StrongPass123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const access = res?.data?.tokens?.accessToken;",
                  "const refresh = res?.data?.tokens?.refreshToken;",
                  "const userId = res?.data?.user?.id;",
                  "if (access) pm.collectionVariables.set('accessToken', access);",
                  "if (refresh) pm.collectionVariables.set('refreshToken', refresh);",
                  "if (userId) pm.collectionVariables.set('userId', userId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "POST Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/admin/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "const access = res?.data?.tokens?.accessToken;",
                  "const refresh = res?.data?.tokens?.refreshToken;",
                  "const adminId = res?.data?.user?.id;",
                  "if (access) pm.collectionVariables.set('accessToken', access);",
                  "if (refresh) pm.collectionVariables.set('refreshToken', refresh);",
                  "if (adminId) pm.collectionVariables.set('adminId', adminId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
        {
          "name": "POST Refresh Token",
          "request": {
            "method": "POST",
